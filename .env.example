# Clave de Meta Model API (https://api.meta.ai) — obligatoria
MODEL_API_KEY=tu_clave_aqui

# WhatsApp Cloud API (Meta Graph API) — solo para envío real.
# Sin estas variables Gancho trabaja en modo simulado: guarda los
# mensajes en outbox/ en vez de enviarlos.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=gancho_verify
# Opcional pero recomendado: valida la firma X-Hub-Signature-256 del webhook.
WHATSAPP_APP_SECRET=
